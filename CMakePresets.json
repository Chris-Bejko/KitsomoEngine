{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "coverage",
      "displayName": "Full Engine Coverage",
      "description": "MSYS2 GCC coverage build that instruments every engine source file and runs unit tests.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/coverage-gcc",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ECSEngine_ENABLE_RUNTIME": "OFF",
        "ECSEngine_COMPILE_ALL_FOR_COVERAGE": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/mingw32-make.exe",
        "CMAKE_C_FLAGS": "--coverage -O0 -g",
        "CMAKE_CXX_FLAGS": "--coverage -O0 -g",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "targets": [
        "ECSEngineCoverageObjects",
        "ECSEngineUnitTests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}